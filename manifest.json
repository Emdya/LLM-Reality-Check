{
  "manifest_version": 3,
  "name": "Reality Check",
  "version": "1.0.0",
  "description": "AI-powered fact-checking for ChatGPT and Claude conversations",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["https://chat.openai.com/*", "https://claude.ai/*", "https://chatgpt.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*", "https://claude.ai/*", "https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Reality Check - Fact Checker"
  },
  "icons": {
    "16": "data:image/svg+xml;base64,",
    "32": "data:image/svg+xml;base64,",
    "48": "data:image/svg+xml;base64,",
    "128": "data:image/svg+xml;base64,"
  },
  "web_accessible_resources": [
    {
      "resources": ["*.js", "*.css", "*.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
